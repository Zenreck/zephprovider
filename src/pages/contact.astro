---
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
import Sectionhead from "../components/sectionhead.astro";
---

<Layout title="Contact">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Contact Us</Fragment>
      <Fragment slot="desc">
        Any questions or ready to order? 24/7 Fast Support just fill out this form or contact +1 (209) 305 4410
      </Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-2 gap-10 mx-auto max-w-4xl mt-12 mb-20">
      <!-- Left Column: Contact Info & Payment Details -->
      <div class="space-y-6">
        <div>
          <h3 class="text-xl font-bold text-slate-900">Get in Touch</h3>
          <p class="text-slate-600 mt-2 text-sm leading-relaxed">
            Reach out directly by phone or meet up locally to drop off or collect your work.
          </p>
        </div>

        <div class="space-y-4 text-slate-700 text-sm">
          <div class="flex items-center gap-3">
            <div class="bg-slate-100 p-2 rounded-lg text-slate-900 font-semibold">
              📞 Phone:
            </div>
            <a href="tel:12093054410" class="hover:text-indigo-600 font-medium">
              +1 (209) 305 4410
            </a>
          </div>

          <div class="flex items-center gap-3">
            <div class="bg-slate-100 p-2 rounded-lg text-slate-900 font-semibold">
              📍 Location:
            </div>
            <span>Edison High School, Stockton, CA</span>
          </div>
        </div>

        <!-- Payment Info Box -->
        <div class="bg-slate-50 border border-slate-200 p-5 rounded-2xl space-y-2">
          <h4 class="font-semibold text-slate-900">Payment Details</h4>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            You pay in person. We accept <strong>Cash App</strong>, <strong>Apple Pay</strong>, <strong>Crypto</strong>, or <strong>Cash/Money</strong>.
          </p>
        </div>
      </div>

      <!-- Right Column: Simple Order / Contact Form (Email field removed) -->
      <div class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm">
        <form class="space-y-4">
          <div>
            <label for="name" class="block text-sm font-medium text-slate-700 mb-1">
              Your Name
            </label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder="Full Name"
              required
              class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
            />
          </div>

          <div>
            <label for="phone" class="block text-sm font-medium text-slate-700 mb-1">
              Phone Number
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              placeholder="+1 (209) 000 0000"
              required
              class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-slate-700 mb-1">
              Details / Order Notes
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              placeholder="Tell us about the assignment or paper details..."
              required
              class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-3 px-4 bg-slate-900 text-white font-medium rounded-lg hover:bg-slate-800 transition-colors text-sm shadow-sm"
          >
            Send Message
          </button>
        </form>
      </div>
    </div>
  </Container>
</Layout>
