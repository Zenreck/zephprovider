---
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
import Sectionhead from "../components/sectionhead.astro";

// Updated array with example names, empty reviews, and removed roles
const reviews = [
  {
    name: "Example 1",
    review: "",
    beforeImg: "/assets/before1.jpg", 
    afterImg: "/assets/after1.jpg",
  },
  {
    name: "Example 2",
    review: "",
    beforeImg: "/assets/before2.jpg",
    afterImg: "/assets/after2.jpg",
  },
  {
    name: "Example 3",
    review: "",
    beforeImg: "/assets/before3.jpg",
    afterImg: "/assets/after3.jpg",
  }
];
---

<Layout title="Client Reviews & Transformations">
  <Container>
    <!-- Section Header using Astroship's pre-built component -->
    <Sectionhead>
      <Fragment slot="title">Client Transformations</Fragment>
      <Fragment slot="desc">
        See the real results and honest feedback from our recent client projects.
      </Fragment>
    </Sectionhead>

    <!-- Reviews Grid -->
    <div class="mt-16 grid gap-12 max-w-5xl mx-auto">
      {reviews.map((item) => (
        <div class="bg-slate-50 p-6 sm:p-8 rounded-xl border border-slate-100 shadow-sm flex flex-col md:flex-row gap-8 items-center">
          
          <!-- Before / After Visual Container -->
          <div class="w-full md:w-1/2 grid grid-cols-2 gap-4">
            <div class="relative">
              <span class="absolute top-2 left-2 bg-black/70 text-white text-xs px-2 py-1 rounded font-semibold uppercase tracking-wider z-10">
                Before
              </span>
              <img 
                src={item.beforeImg} 
                alt={`${item.name} - Before`} 
                class="w-full aspect-[4/3] object-cover rounded-lg bg-slate-200 border border-slate-200 shadow-sm"
                loading="lazy"
              />
            </div>
            <div class="relative">
              <span class="absolute top-2 left-2 bg-blue-600 text-white text-xs px-2 py-1 rounded font-semibold uppercase tracking-wider z-10">
                After
              </span>
              <img 
                src={item.afterImg} 
                alt={`${item.name} - After`} 
                class="w-full aspect-[4/3] object-cover rounded-lg bg-slate-200 border border-slate-200 shadow-sm"
                loading="lazy"
              />
            </div>
          </div>

          <!-- Review Content Container -->
          <div class="w-full md:w-1/2 flex flex-col justify-center">
            <!-- 5-Star Rating Indicator -->
            <div class="flex text-amber-400 mb-3" aria-hidden="true">
              {[...Array(5)].map(() => (
                <svg xmlns="http://w3.org" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                  <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
                </svg>
              ))}
            </div>
            
            {item.review && (
              <blockquote class="text-slate-700 italic text-lg leading-relaxed mb-4">
                "{item.review}"
              </blockquote>
            )}
            
            <div>
              <h3 class="font-bold text-slate-900 text-lg">{item.name}</h3>
            </div>
          </div>

        </div>
      ))}
    </div>
  </Container>
</Layout>
