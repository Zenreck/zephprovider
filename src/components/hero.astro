---
import Link from '@components/ui/Link.astro';
---

<main class="max-w-4xl mx-auto px-4 py-12 md:py-20 text-center">
  <div class="space-y-6">
    <!-- Main Headline -->
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-slate-900 leading-tight">
      Pay Fast, Services Fast
    </h1>

    <!-- Structured, Readable Description -->
    <div class="text-slate-600 text-base sm:text-lg leading-relaxed space-y-4 text-left sm:text-center max-w-2xl mx-auto bg-slate-50 p-6 sm:p-8 rounded-2xl border border-slate-100 shadow-sm">
      <p>
        We Have Alot of Services to provide you at Edison High School Stockton Ca, This website is made from serveral people to keep it secret from staff at the school
      </p>
      
      <div class="border-t border-slate-200 pt-4 space-y-3 text-sm sm:text-base">
        <p class="font-semibold text-slate-800">Our Service Options:</p>
        <ul class="list-disc list-inside space-y-2 text-slate-600 text-left">
          <li><strong>No-AI Option:</strong> Hand-researched and written entirely by hand without AI tools.</li>
          <li><strong>Custom AI Option:</strong> Uses a tailored AI tuned to match your personal vocabulary and writing style so it looks 100% natural and undetected.</li>
          <li><strong>Flexible Delivery:</strong> We can complete the work for you or provide step-by-step notes so you can write it out in your own handwriting. Meet up locally to exchange materials securely.</li>
        </ul>
      </div>
    </div>
    
    <!-- Action Buttons -->
    <div class="pt-4 flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a
        href="/pricing"
        class="w-full sm:w-auto px-8 py-3 text-center text-sm font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-xl transition-all shadow-md hover:shadow-lg"
      >
        View Prices
      </a>

      <a
        href="/contact"
        class="w-full sm:w-auto px-8 py-3 text-center text-sm font-semibold text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 hover:text-slate-900 rounded-xl transition-all shadow-sm"
      >
        Contact Us
      </a>
    </div>
  </div>
</main>
