---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Bring Your Own Work/Paper",
    description: "Send the work and receive fast",
    icon: "bx:bxs-briefcase",
  },
  {
    title: "100% Fast and Legit",
    description: "Reliable and trustworthy",
    icon: "bx:bxs-window-alt",
  },
  {
    title: "On-Demand",
    description: "We accept mostly any type of work you have",
    icon: "bx:bxs-data",
  },
  {
    title: "Community",
    description: "A highly capable fast community",
    icon: "bx:bxs-user",
  },
];
---

<div class="mt-16 md:mt-0 text-center max-w-3xl mx-auto">
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight text-slate-900">
    Pay Fast, Done Fast
  </h2>
  <p class="text-lg mt-4 text-slate-600 leading-relaxed">
    Pay Fast and choose a location to meet up to send the work or paper you want to complete and meet back up in the same spot when finished (finishing the work depends on how much or how long it is).
  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-2 mt-16 gap-16 max-w-4xl mx-auto">
  {
    features.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-black rounded-full  p-2 w-8 h-8 shrink-0">
          <Icon class="text-white" name={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-lg">{item.title}</h3>{" "}
          <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
