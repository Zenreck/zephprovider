---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Bring Your Own Work/Paper",
    description: "Send the work and receive it done fast",
    icon: "bx:bxs-briefcase",
  },
  {
    title: "100% Fast and Legit",
    description: "Reliable and trustworthy",
    icon: "bx:bxs-window-alt",
  },
  {
    title: "On-Demand",
    description: "We accept mostly any type of payment",
    icon: "bx:bxs-data",
  },
  {
    title: "Services",
    description: "Several Services to provide",
    icon: "bx:bxs-user",
  },
];
---

<div class="mt-16 md:mt-0 text-center max-w-3xl mx-auto">
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight text-slate-900">
    Pay Fast, Get Better Grades Fast
  </h2>
  <p class="text-lg mt-4 text-slate-600 leading-relaxed">
    Choose a locaton to meet up, once you text us that your there we will go there right away, we will take pictures of the work and we will give you what the AI put, If its not AI we will take pictures of your work and we will fully research about it, !!Once you meet up before we do the work you must pay to ensure you do not scam!! WE USE HIGHLY PREMIUM AI HARDWARE USING RTX 5070 COMPUTER HARDWARE TO ENSURE 100% LEGIT WORK THAT LOOKS LIKE YOU MADE IT.
  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-2 mt-16 gap-16 max-w-4xl mx-auto">
  {
    features.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-black rounded-full  p-2 w-8 h-8 shrink-0">
          <Icon class="text-white" name={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-lg">{item.title}</h3>{" "}
          <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
